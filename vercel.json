{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/firebase-config.js",
      "destination": "/api/firebase-config.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
